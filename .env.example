# Azure Virtual Desktop Demo Environment Configuration
# Copy this file to .env and update the values for your environment

# Required Settings
AZURE_LOCATION=East US 2
AADDS_DOMAIN_NAME=contoso-mct.com

# Optional Settings (with defaults)
AVD_ADMIN_USERNAME=avdadmin
VNET_ADDRESS_PREFIX=10.29.0.0/16
SUBNET_ADDRESS_PREFIX=10.29.1.0/24
SESSION_HOST_COUNT=2

# Azure AD Group IDs (leave empty to create new groups)
AVD_ADMINS_GROUP_ID=
AVD_USERS_GROUP_ID=

# VM Password (will be prompted securely if not set)